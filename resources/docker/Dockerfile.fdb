# Declare TARGETPLATFORM globally
ARG TARGETPLATFORM

# --- Chef Stage ---
FROM debian:bookworm-slim AS chef
# Re-declare TARGETPLATFORM for use in this stage
ARG TARGETPLATFORM
RUN apt-get update && \
    export DEBIAN_FRONTEND=noninteractive && \
    apt-get install -yq \
    build-essential \
    cmake \
    clang \
    curl \
    protobuf-compiler
ENV RUSTUP_HOME=/opt/rust/rustup \
    PATH=/home/root/.cargo/bin:/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl https://sh.rustup.rs -sSf | \
    env CARGO_HOME=/opt/rust/cargo \
    sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path && \
    env CARGO_HOME=/opt/rust/cargo \
    rustup component add rustfmt

# Modified case statement to check the full platform string
RUN case ${TARGETPLATFORM} in \
        "linux/amd64") FDB_ARCH="amd64" ;; \
        "linux/arm64") FDB_ARCH="aarch64" ;; \
        *) echo "Unsupported platform: ${TARGETPLATFORM}"; exit 1 ;; \
    esac && \
    curl -LO https://github.com/apple/foundationdb/releases/download/7.3.63/foundationdb-clients_7.3.63-1_${FDB_ARCH}.deb && \
    dpkg -i foundationdb-clients_7.3.63-1_${FDB_ARCH}.deb

RUN env CARGO_HOME=/opt/rust/cargo cargo install cargo-chef && \
    rm -rf /opt/rust/cargo/registry/
WORKDIR /app

# --- Planner Stage ---
FROM chef AS planner
COPY Cargo.toml .
COPY Cargo.lock .
COPY crates/ crates/
COPY resources/ resources/
COPY tests/ tests/
RUN cargo chef prepare --recipe-path recipe.json

# --- Builder Stage ---
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml .
COPY Cargo.lock .
COPY crates/ crates/
COPY resources/ resources/
COPY tests/ tests/
RUN cargo build --manifest-path=crates/main/Cargo.toml --no-default-features --features "foundationdb,zenoh" --release


# --- Runtime Stage ---
FROM debian:bookworm-slim AS runtime

# Re-declare TARGETPLATFORM for the final stage
ARG TARGETPLATFORM

COPY --from=builder /app/target/release/stalwart /usr/local/bin/stalwart

# Install dependencies, download the package, and clean up all in one layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    \
    case ${TARGETPLATFORM} in \
        "linux/amd64") FDB_ARCH="amd64" ;; \
        "linux/arm64") FDB_ARCH="aarch64" ;; \
        *) echo "Unsupported platform: ${TARGETPLATFORM}"; exit 1 ;; \
    esac && \
    \
    echo "Downloading FoundationDB for ${FDB_ARCH}..." && \
    curl -fSLo foundationdb-clients.deb "https://github.com/apple/foundationdb/releases/download/7.3.63/foundationdb-clients_7.3.63-1_${FDB_ARCH}.deb" && \
    \
    dpkg -i foundationdb-clients.deb && \
    rm foundationdb-clients.deb && \
    \
    # Clean up build dependencies to keep the image small
    apt-get purge -y --auto-remove curl && \
    rm -rf /var/lib/apt/lists/*

RUN useradd stalwart -s /sbin/nologin -M
RUN mkdir -p /opt/stalwart
RUN chown stalwart:stalwart /opt/stalwart

ENTRYPOINT ["/usr/local/bin/stalwart", "--config", "/opt/stalwart/etc/config.toml"]
